.trend-chart-container {
  position: relative;
  width: 100%;
  height: 360rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.trend-chart-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.trend-chart-empty {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.trend-chart-empty .empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

.trend-tooltip {
  position: absolute;
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s;
  transform: translate(-50%, -120%);
  white-space: nowrap;
  z-index: 10;
}

.trend-tooltip.show {
  opacity: 1;
}

.trend-tooltip-date {
  font-size: 22rpx;
  opacity: 0.8;
  margin-bottom: 4rpx;
}

.trend-tooltip-value {
  font-size: 28rpx;
  font-weight: 600;
}
