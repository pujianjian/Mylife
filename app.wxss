/* 全局样式 */
page {
  --primary: #07C160;
  --primary-light: #E6F7EF;
  --weight-color: #4A90D9;
  --weight-light: #EBF3FC;
  --savings-color: #FF9500;
  --savings-light: #FFF4E5;
  --danger: #FA5151;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --border: #EEEEEE;
  --bg: #F5F6FA;
  --white: #FFFFFF;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  
  background-color: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-label {
  width: 140rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 80rpx;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-textarea {
  flex: 1;
  height: 140rpx;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.btn {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: opacity 0.2s;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background: var(--primary);
  color: var(--white);
}

.btn-weight {
  background: var(--weight-color);
  color: var(--white);
}

.btn-savings {
  background: var(--savings-color);
  color: var(--white);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.list-item:last-child {
  border-bottom: none;
}

.delete-btn {
  color: var(--danger);
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
