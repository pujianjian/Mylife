.page {
  min-height: 100vh;
  background: #F5F6FA;
  padding-bottom: 40rpx;
}

/* ========== 顶部 Tab ========== */
.top-tabs {
  display: flex;
  background: #fff;
  padding: 12rpx 24rpx;
  gap: 8rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.top-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #F3F4F6;
  transition: all 0.2s;
}

.top-tab.active {
  background: #10B981;
}

.tab-text {
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
}

.top-tab.active .tab-text {
  color: #fff;
  font-weight: 700;
}

.tab-content {
  padding: 24rpx;
}

/* ========== 通用标题 ========== */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
  margin: 24rpx 0 16rpx;
}

/* ========== 有数（首页）========== */

/* 资产总览卡片 */
.overview-card {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(16, 185, 129, 0.15);
}

.overview-main {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 28rpx;
}

.overview-main-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.overview-main-label {
  font-size: 24rpx;
  color: #065F46;
}

.overview-main-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #064E3B;
}

.overview-divider {
  width: 1rpx;
  height: 70rpx;
  background: rgba(6, 95, 70, 0.2);
}

.overview-status {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(6, 95, 70, 0.15);
}

.overview-status-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.status-dot.active {
  background: #84CC16;
}

.status-dot.retired {
  background: #F59E0B;
}

.status-dot.sold {
  background: #6B7280;
}

.overview-status-text {
  font-size: 24rpx;
  color: #065F46;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.filter-tab {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #6B7280;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.filter-tab.active {
  background: #10B981;
  color: #fff;
  font-weight: 600;
}

/* 资产网格 */
.asset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.asset-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.asset-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 4rpx;
}

.asset-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #F0FDF4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.asset-card-icon {
  font-size: 40rpx;
}

.asset-status-tag {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.asset-status-tag.active {
  background: #ECFCCB;
  color: #65A30D;
}

.asset-status-tag.retired {
  background: #FEF3C7;
  color: #D97706;
}

.asset-status-tag.sold {
  background: #F3F4F6;
  color: #6B7280;
}

.asset-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-card-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #10B981;
}

.asset-card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

.meta-divider {
  color: #D1D5DB;
}

/* ========== 心愿 ========== */

/* 心愿总值卡片 */
.wish-summary-card {
  background: linear-gradient(135deg, #FBCFE8 0%, #F472B6 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(236, 72, 153, 0.2);
}

.wish-summary-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.wish-summary-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.wish-summary-total {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.wish-summary-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.wish-summary-emoji {
  font-size: 72rpx;
}

/* 心愿列表 */
.wish-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wish-card-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.wish-card-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wish-card-icon {
  font-size: 44rpx;
}

.wish-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.wish-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.wish-card-target {
  font-size: 24rpx;
  color: #9CA3AF;
}

.wish-card-percent {
  font-size: 28rpx;
  font-weight: 700;
  color: #EC4899;
}

.wish-progress-bar {
  width: 100%;
  height: 12rpx;
  background: #F3F4F6;
  border-radius: 6rpx;
  overflow: hidden;
}

.wish-progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #F472B6 0%, #EC4899 100%);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.wish-card-amount {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #6B7280;
}

/* ========== 趋势 ========== */

/* 时间筛选 */
.trend-ranges {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.trend-range {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #6B7280;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.trend-range.active {
  background: #10B981;
  color: #fff;
  font-weight: 600;
}

/* 趋势卡片 */
.trend-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.trend-card-header {
  margin-bottom: 20rpx;
}

.trend-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

/* 状态图表 */
.status-chart {
  display: flex;
  gap: 24rpx;
  height: 200rpx;
  align-items: flex-end;
}

.status-chart-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.status-chart-bar {
  width: 60rpx;
  height: 160rpx;
  background: #F3F4F6;
  border-radius: 8rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.status-chart-fill {
  width: 100%;
  border-radius: 8rpx;
  min-height: 4rpx;
}

.status-chart-label {
  font-size: 22rpx;
  color: #6B7280;
}

.status-chart-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6B7280;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* ========== 添加按钮 ========== */
.add-btn-wrap {
  padding: 32rpx 0 40rpx;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  color: #fff;
}

.add-btn::after {
  border: none;
}

.add-btn-green {
  background: linear-gradient(135deg, #34D399 0%, #10B981 100%);
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}

.add-btn-pink {
  background: linear-gradient(135deg, #F472B6 0%, #EC4899 100%);
  box-shadow: 0 8rpx 24rpx rgba(236, 72, 153, 0.3);
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  max-height: 82vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
  flex-shrink: 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}

.modal-close {
  font-size: 48rpx;
  color: #9CA3AF;
  line-height: 1;
}

.modal-form {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 76rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  align-items: center;
  line-height: 76rpx;
}

.input-unit {
  margin-left: 12rpx;
  color: #9CA3AF;
  font-size: 26rpx;
  flex-shrink: 0;
  width: 56rpx;
}

.form-textarea {
  flex: 1;
  height: 120rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.modal-actions {
  padding: 20rpx 32rpx 40rpx;
  border-top: 1rpx solid #F3F4F6;
  flex-shrink: 0;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-green {
  background: linear-gradient(135deg, #34D399 0%, #10B981 100%);
}

.btn-pink {
  background: linear-gradient(135deg, #F472B6 0%, #EC4899 100%);
}
