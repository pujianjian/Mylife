.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 140rpx;
}

.header {
  padding: 40rpx 0 48rpx;
}

.welcome {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 30rpx;
  color: var(--text-secondary);
}

.modules-grid {
  margin-bottom: 32rpx;
}

.module-card {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.module-card:active {
  transform: scale(0.98);
}

.module-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.module-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.module-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.module-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.module-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.arrow {
  font-size: 48rpx;
  font-weight: 300;
}

.tips-card {
  display: flex;
  flex-direction: column;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.tips-item {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}
