.mine-page {
  padding-bottom: 140rpx;
}

/* 个人中心头部 */
.profile-header {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #4A90D9, #6BB5E8);
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 217, 0.2);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.profile-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 数据概览 */
.stats-card .stats-grid {
  display: flex;
  gap: 24rpx;
}

.stat-item {
  flex: 1;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 28rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 功能菜单 */
.menu-group {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  position: relative;
}

.menu-item:active {
  background: var(--bg);
}

.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--border);
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-label {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary);
}

/* 关于卡片 */
.about-card {
  text-align: center;
  padding: 24rpx;
}

.about-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}
