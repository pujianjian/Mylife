<view class="container mine-page">
  <!-- 个人中心头部 -->
  <view class="profile-header">
    <view class="avatar">📊</view>
    <view class="profile-info">
      <text class="profile-name">健康理财小助手</text>
      <text class="profile-desc">记录健康 · 管理财富</text>
    </view>
  </view>

  <!-- 数据概览 -->
  <view class="stats-card card">
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-value">{{weightCount}}</text>
        <text class="stat-label">健康记录</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{assetCount}}</text>
        <text class="stat-label">储存账户</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{carCount}}</text>
        <text class="stat-label">汽车账目</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-group card">
    <view class="menu-item" bindtap="goToBackup">
      <view class="menu-left">
        <text class="menu-icon">💾</text>
        <text class="menu-label">数据备份</text>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-item" bindtap="goToFeedback">
      <view class="menu-left">
        <text class="menu-icon">📋</text>
        <text class="menu-label">需求登记反馈</text>
      </view>
      <view class="menu-right">
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about-card card">
    <text class="about-text">数据存储在本地，换机或清理缓存前请务必备份。</text>
  </view>

  <tabbar active="{{1}}"></tabbar>
</view>
