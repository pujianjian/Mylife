.todo-page {
  padding-bottom: 160rpx;
}

/* 今日概览卡片 */
.overview-card {
  background: linear-gradient(135deg, #06B6D4, #0891B2);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.2);
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.overview-date-text {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 4rpx;
}

.overview-date-label {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.rate-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
}

.overview-progress {
  margin-bottom: 24rpx;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.overview-stats {
  display: flex;
  gap: 16rpx;
}

.ov-stat {
  flex: 1;
  text-align: center;
}

.ov-stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.ov-stat-done {
  color: #ECFEFF;
}

.ov-stat-pending {
  color: #FEF3C7;
}

.ov-stat-txt {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

/* 区块标题 */
.section {
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 28rpx;
}

/* 今日待办列表 */
.today-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  gap: 16rpx;
}

.todo-item.done {
  opacity: 0.55;
}

.todo-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.todo-check.checked {
  background: #06B6D4;
  border-color: #06B6D4;
}

.check-icon {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

.todo-main {
  flex: 1;
  min-width: 0;
}

.todo-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.todo-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-item.done .todo-title {
  text-decoration: line-through;
  color: #9CA3AF;
}

.todo-freq-tag {
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.todo-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.todo-time {
  font-size: 24rpx;
  color: #6B7280;
}

.todo-pri {
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 频率 Tab */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.tab-item.active {
  font-weight: 600;
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.tab-name {
  font-size: 24rpx;
  color: #6B7280;
}

.tab-item.active .tab-name {
  color: inherit;
}

/* 频率列表 */
.freq-list-wrap {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.freq-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.freq-item-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-right: 16rpx;
  padding-top: 4rpx;
}

.freq-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.freq-check.checked {
  background: #06B6D4;
  border-color: #06B6D4;
}

.freq-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.freq-item-main {
  flex: 1;
  min-width: 0;
}

.freq-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.freq-item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.text-done {
  text-decoration: line-through;
  color: #9CA3AF;
}

.freq-item-pri {
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.freq-item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.freq-schedule {
  font-size: 24rpx;
  color: #6B7280;
}

.freq-time {
  font-size: 24rpx;
  color: #0891B2;
}

.freq-item-desc {
  display: block;
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.5;
}

.freq-item-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 4rpx;
}

.freq-action {
  font-size: 22rpx;
  color: #06B6D4;
  font-weight: 500;
}

.freq-action-danger {
  color: #EF4444;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #9CA3AF;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #D1D5DB;
}

/* 底部按钮 */
.add-btn-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  display: flex;
  justify-content: center;
}

.add-btn {
  width: 100%;
  max-width: 500rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #06B6D4, #0891B2);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 88rpx;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(6, 182, 212, 0.3);
}

.add-btn::after {
  border: none;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
  flex-shrink: 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}

.modal-close {
  font-size: 36rpx;
  color: #9CA3AF;
  padding: 8rpx;
}

.modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.required {
  color: #EF4444;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  align-items: center;
  line-height: 84rpx;
}

.freq-color-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.yearly-pickers {
  display: flex;
  gap: 16rpx;
}

.yearly-picker {
  flex: 1;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F3F4F6;
  flex-shrink: 0;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 88rpx;
  padding: 0;
}

.btn-cancel::after {
  border: none;
}

.btn-save {
  flex: 2;
  height: 88rpx;
  background: linear-gradient(135deg, #06B6D4, #0891B2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 88rpx;
  padding: 0;
}

.btn-save::after {
  border: none;
}

/* ======== 个人爱好样式 ======== */

/* 爱好统计卡片 */
.hobby-summary-card {
  display: flex;
  justify-content: space-around;
  background: linear-gradient(135deg, #10B981, #059669);
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  margin-bottom: 24rpx;
}

.hobby-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hobby-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.hobby-stat-txt {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* 爱好列表项 */
.hobby-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.hobby-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.hobby-item-left {
  display: flex;
  align-items: center;
}

.hobby-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.hobby-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.hobby-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid;
  background: rgba(255, 255, 255, 0.5);
}

/* 进度条 */
.hobby-progress-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.hobby-progress-bar {
  flex: 1;
  height: 12rpx;
  background: #E5E7EB;
  border-radius: 6rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.hobby-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.hobby-progress-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
  min-width: 70rpx;
  text-align: right;
}

/* 目标 */
.hobby-goal {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.hobby-goal-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.hobby-goal-text {
  font-size: 26rpx;
  color: #10B981;
  font-weight: 500;
}

/* 描述 */
.hobby-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
  margin-bottom: 16rpx;
  padding: 12rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

/* 爱好操作按钮 */
.hobby-item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F3F4F6;
}

.hobby-action {
  font-size: 26rpx;
  color: #6B7280;
}

.hobby-action-danger {
  color: #EF4444;
}
