.page {
  min-height: 100vh;
  background: #F5F6FA;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ========== 黄色头部 ========== */
.detail-header {
  background: linear-gradient(135deg, #FCD34D 0%, #FBBF24 100%);
  padding: 32rpx 24rpx 48rpx;
}

.header-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  position: relative;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.header-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}

.header-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FEE2E2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-icon {
  font-size: 36rpx;
}

.header-amount-row {
  margin-bottom: 8rpx;
}

.header-amount {
  font-size: 64rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.2;
}

.header-type {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 24rpx;
  display: block;
}

.adjust-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FCD34D 0%, #FBBF24 100%);
  color: #1F2937;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1.4;
}

.adjust-btn::after {
  border: none;
}

/* ========== 收支明细 ========== */
.tx-section {
  padding: 0 24rpx;
  margin-top: -20rpx;
}

.tx-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0 16rpx;
}

.tx-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.month-picker-wrap {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #F3F4F6;
  border-radius: 10rpx;
}

.month-text {
  font-size: 26rpx;
  color: #4B5563;
  font-weight: 500;
}

.month-arrow {
  font-size: 18rpx;
  color: #9CA3AF;
  margin-left: 8rpx;
}

.month-text-static {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* 变动列表 */
.tx-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.tx-item {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-date-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.tx-date {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-right: 12rpx;
}

.tx-weekday {
  font-size: 24rpx;
  color: #CBD5E1;
}

.tx-content {
  display: flex;
  align-items: center;
}

.tx-icon-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tx-icon {
  font-size: 32rpx;
}

.tx-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tx-desc {
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.tx-from-to {
  font-size: 24rpx;
  color: #9CA3AF;
}

.tx-change {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.tx-change.positive {
  color: #10B981;
}

.tx-change.negative {
  color: #EF4444;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #9CA3AF;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
}

.empty-sub {
  font-size: 24rpx;
  color: #CBD5E1;
  margin-top: 12rpx;
}

/* ========== 底部操作栏 ========== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
}

.action-item.delete-action .action-label {
  color: #EF4444;
}

.action-icon {
  font-size: 32rpx;
}

.action-label {
  font-size: 26rpx;
  color: #4B5563;
  font-weight: 500;
}

.action-divider {
  width: 1rpx;
  height: 44rpx;
  background: #E5E7EB;
}

/* ========== 调整弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
}

.modal-close {
  font-size: 48rpx;
  color: #9CA3AF;
  line-height: 1;
}

.current-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFBEB;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  margin-bottom: 28rpx;
}

.current-label {
  font-size: 26rpx;
  color: #B45309;
}

.current-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #B45309;
}

/* ========== 模式切换 ========== */
.mode-switch {
  display: flex;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #6B7280;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.mode-btn.active {
  background: #fff;
  color: #F59E0B;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* ========== 全量预览 ========== */
.preview-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin: -12rpx 0 24rpx;
  padding-right: 8rpx;
}

.preview-label {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-right: 12rpx;
}

.preview-value {
  font-size: 28rpx;
  font-weight: 600;
}

.preview-value.positive {
  color: #10B981;
}

.preview-value.negative {
  color: #EF4444;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 80rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2937;
}

.modal-actions {
  margin-top: 32rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  color: #fff;
}

.btn::after {
  border: none;
}

.btn-save {
  background: #FBBF24;
  color: #1F2937;
}
