.page {
  min-height: 100vh;
  background: #F3F4F6;
  padding-bottom: 220rpx;
}

/* ============== 顶部统计卡 ============== */
.summary-card {
  background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%);
  margin: 24rpx 32rpx 0;
  border-radius: 24rpx;
  padding: 32rpx 32rpx 40rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.25);
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-title {
  font-size: 28rpx;
  opacity: 0.9;
  font-weight: 500;
}

.cycle-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  opacity: 0.95;
}

.cycle-arrow {
  font-size: 28rpx;
  margin-top: 2rpx;
}

.summary-amount {
  margin-top: 16rpx;
}

.amount-value {
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.summary-count {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* ============== 账目列表 ============== */
.section {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.query-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.query-text {
  font-size: 24rpx;
  color: #6B7280;
}

.query-arrow {
  font-size: 26rpx;
  color: #9CA3AF;
}

.day-group {
  border-bottom: 1rpx solid #F3F4F6;
}

.day-group:last-child {
  border-bottom: none;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #F9FAFB;
}

.day-label {
  font-size: 24rpx;
  color: #6B7280;
}

.day-total {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 600;
}

.expense-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.expense-item:last-child {
  border-bottom: none;
}

.expense-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #EFF6FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.expense-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.expense-name {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}

.expense-note {
  font-size: 22rpx;
  color: #9CA3AF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expense-amount {
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ============== 空状态 ============== */
.empty {
  padding: 80rpx 32rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: #9CA3AF;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: #D1D5DB;
}

/* ============== 底部按钮 ============== */
.bottom-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 48rpx;
  display: flex;
  gap: 20rpx;
  z-index: 50;
}

.bottom-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.3);
}

.btn-other {
  background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%);
  color: #fff;
}

/* ============== 周期选择 ============== */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 0 32rpx;
}

.picker-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.picker-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: #1F2937;
  border-bottom: 1rpx solid #F9FAFB;
}

.picker-option.active {
  color: #3B82F6;
  font-weight: 600;
}

.picker-check {
  color: #3B82F6;
  font-size: 32rpx;
}

.picker-cancel {
  text-align: center;
  margin-top: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #6B7280;
  border-top: 1rpx solid #F3F4F6;
}
