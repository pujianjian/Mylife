<view class="page">
  <view class="summary-card">
    <view class="summary-header">
      <view class="summary-title-wrap">
        <text class="summary-title">支出统计</text>
      </view>
      <view class="cycle-btn" bindtap="onCycleTap">
        <text class="cycle-text">{{currentCycleName}}</text>
        <text class="cycle-arrow">v</text>
      </view>
    </view>
    <view class="summary-amount">
      <text class="amount-value">{{totalStr}}</text>
    </view>
    <view class="summary-count">
      <text>共 {{summaryCount}} 笔支出</text>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">全部账目</text>
      <view class="query-link" bindtap="onQueryTap">
        <text class="query-text">账目查询</text>
        <text class="query-arrow">+</text>
      </view>
    </view>

    <block wx:for="{{monthGroups}}" wx:key="date" wx:for-item="dayGroup">
      <view class="day-group">
        <view class="day-header">
          <text class="day-label">{{dayGroup.dateLabel}}</text>
          <text class="day-total">{{dayGroup.totalStr}}</text>
        </view>
        <view
          class="expense-item"
          wx:for="{{dayGroup.items}}"
          wx:key="id"
          wx:for-item="expense"
          data-id="{{expense.id}}"
          bindtap="onItemTap"
        >
          <view class="expense-icon">
            <text>{{expense.icon}}</text>
          </view>
          <view class="expense-info">
            <text class="expense-name">{{expense.typeName}}</text>
            <text wx:if="{{expense.note}}" class="expense-note">{{expense.note}}</text>
          </view>
          <text class="expense-amount">{{expense.amountStr}}</text>
        </view>
      </view>
    </block>

    <view wx:if="{{monthGroups.length === 0}}" class="empty">
      <text class="empty-icon">car</text>
      <text>暂无用车支出</text>
      <text class="empty-hint">点击下方按钮开始记录</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="bottom-btn btn-other" bindtap="onAddOther">
      <text>新增支出</text>
    </view>
  </view>

  <view wx:if="{{showCyclePicker}}" class="picker-mask" bindtap="onCycleClose">
    <view class="picker-panel" catchtap="noop">
      <view class="picker-title">选择周期</view>
      <view
        wx:for="{{cycles}}"
        wx:key="key"
        wx:for-item="cyc"
        class="{{cyc.key === cycle ? 'picker-option active' : 'picker-option'}}"
        data-cycle="{{cyc.key}}"
        bindtap="onCycleSelect"
      >
        <text>{{cyc.name}}</text>
        <text wx:if="{{cyc.key === cycle}}" class="picker-check">+</text>
      </view>
      <view class="picker-cancel" bindtap="onCycleClose">取消</view>
    </view>
  </view>
</view>
