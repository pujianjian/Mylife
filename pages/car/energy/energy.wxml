<wxs module="calc" src="./energy.wxs" />
<view class="page">
  <!-- 顶部蓝色 header -->
  <view class="header">
    <view class="header-left" bindtap="onCategorySwap">
      <text class="header-title">{{category === 'fuel' ? '油费支出' : '新能源支出'}}</text>
      <text class="header-swap">⇄</text>
    </view>
    <picker mode="date" value="{{date}}" bindchange="onPickDate">
      <view class="header-date">
        <text>{{date}}</text>
        <text class="header-arrow">⌄</text>
      </view>
    </picker>
  </view>

  <!-- 记总价/记明细 选择 -->
  <view class="white-block mode-block">
    <view class="mode-row" data-mode="total" bindtap="onModeChange">
      <view class="{{'mode-radio ' + (mode === 'total' ? 'on' : '')}}">
        <text wx:if="{{mode === 'total'}}" class="radio-check">✓</text>
      </view>
      <text class="mode-text">记总价</text>
    </view>
  </view>

  <!-- 记总价：金额输入 -->
  <view wx:if="{{mode === 'total'}}" class="white-block amount-block">
    <view class="amount-row">
      <text class="amount-symbol">¥</text>
      <input
        class="amount-input"
        type="digit"
        placeholder="0.00"
        placeholder-class="amount-placeholder"
        value="{{amount}}"
        bindinput="onAmountInput"
      />
    </view>
  </view>

  <!-- 记明细：油量 × 油价 = 金额 -->
  <view wx:elif="{{mode === 'detail'}}" class="white-block detail-block">
    <view wx:if="{{category === 'fuel'}}" class="detail-row">
      <view class="detail-item">
        <input
          class="detail-input"
          type="digit"
          placeholder="0.00"
          placeholder-class="amount-placeholder"
          value="{{fuelLiters}}"
          bindinput="onLitersInput"
        />
        <text class="detail-unit">油量 L</text>
      </view>
      <text class="detail-times">×</text>
      <view class="detail-item">
        <input
          class="detail-input"
          type="digit"
          placeholder="0.00"
          placeholder-class="amount-placeholder"
          value="{{fuelPrice}}"
          bindinput="onPriceInput"
        />
        <text class="detail-unit">油价 元/L</text>
      </view>
      <text class="detail-times">=</text>
      <view class="detail-item">
        <text class="detail-result">{{calc.formatResult(fuelLiters, fuelPrice)}}</text>
        <text class="detail-unit">元</text>
      </view>
    </view>
    <view wx:else class="detail-row">
      <view class="detail-item">
        <input
          class="detail-input"
          type="digit"
          placeholder="0.00"
          placeholder-class="amount-placeholder"
          value="{{evKwh}}"
          bindinput="onKwhInput"
        />
        <text class="detail-unit">度数 kWh</text>
      </view>
      <text class="detail-times">×</text>
      <view class="detail-item">
        <input
          class="detail-input"
          type="digit"
          placeholder="0.00"
          placeholder-class="amount-placeholder"
          value="{{evPrice}}"
          bindinput="onEvPriceInput"
        />
        <text class="detail-unit">电价 元/度</text>
      </view>
      <text class="detail-times">=</text>
      <view class="detail-item">
        <text class="detail-result">{{calc.formatResult(evKwh, evPrice)}}</text>
        <text class="detail-unit">元</text>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="white-block note-block">
    <view class="note-label">备注</view>
    <input
      class="note-input"
      placeholder="10字以内"
      maxlength="10"
      value="{{note}}"
      bindinput="onNoteInput"
    />
  </view>

  <!-- 保存按钮 -->
  <view class="save-wrap">
    <view class="{{'save-btn ' + (formValid ? 'active' : '')}}" bindtap="onSave">
      <text>保存</text>
    </view>
  </view>
</view>
