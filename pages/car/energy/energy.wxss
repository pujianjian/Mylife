.page {
  min-height: 100vh;
  background: #F3F4F6;
  padding-bottom: 200rpx;
}

/* ============== 顶部蓝色 header ============== */
.header {
  background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%);
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #fff;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
}

.header-swap {
  font-size: 28rpx;
  opacity: 0.9;
}

.header-date {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  opacity: 0.95;
}

.header-arrow {
  font-size: 24rpx;
  margin-top: 2rpx;
}

/* ============== 白色卡片 ============== */
.white-block {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}

/* ============== 模式选择 ============== */
.mode-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mode-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode-radio.on {
  border-color: #3B82F6;
  background: #3B82F6;
}

.radio-check {
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
}

.mode-text {
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 500;
}

/* ============== 金额 ============== */
.amount-block {
  padding: 36rpx 32rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.amount-symbol {
  font-size: 48rpx;
  font-weight: 600;
  color: #3B82F6;
}

.amount-input {
  flex: 1;
  font-size: 64rpx;
  font-weight: 700;
  color: #3B82F6;
  height: 80rpx;
  line-height: 80rpx;
}

.amount-placeholder {
  color: #BFDBFE;
}

/* ============== 明细输入 ============== */
.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 18rpx 8rpx;
}

.detail-input {
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  color: #3B82F6;
  font-weight: 600;
  height: 44rpx;
}

.detail-result {
  font-size: 28rpx;
  color: #3B82F6;
  font-weight: 700;
}

.detail-unit {
  font-size: 20rpx;
  color: #6B7280;
}

.detail-times {
  font-size: 28rpx;
  color: #9CA3AF;
  font-weight: 600;
  padding: 0 4rpx;
}

/* ============== 备注 ============== */
.note-label {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.note-input {
  font-size: 28rpx;
  color: #1F2937;
  height: 44rpx;
}

/* ============== 保存按钮 ============== */
.save-wrap {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 48rpx;
}

.save-btn {
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: #BFDBFE;
  letter-spacing: 2rpx;
  transition: all 0.2s;
}

.save-btn.active {
  background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%);
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.3);
}
