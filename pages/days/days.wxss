.page {
  min-height: 100vh;
  background: #EFF6FF;
  padding-bottom: 60rpx;
}

/* ============== 头部 ============== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 12rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1E3A8A;
  letter-spacing: 1rpx;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #3B82F6;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.35);
}

.add-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* ============== 分类 Tab ============== */
.tabs {
  white-space: nowrap;
  padding: 16rpx 24rpx 20rpx;
}

.tab {
  display: inline-block;
  padding: 14rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #fff;
  font-size: 28rpx;
  color: #6B7280;
  border: 2rpx solid transparent;
}

.tab.active {
  background: #3B82F6;
  color: #fff;
  font-weight: 600;
  border-color: #3B82F6;
}

/* ============== 统计卡 ============== */
.stats {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-card.highlight {
  background: linear-gradient(135deg, #DBEAFE 0%, #EFF6FF 100%);
}

.stat-label {
  font-size: 22rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 8rpx;
}

.stat-value-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E3A8A;
}

.stat-unit {
  font-size: 22rpx;
  color: #6B7280;
}

.stat-nearest {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.stat-nearest-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E3A8A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-nearest-meta {
  font-size: 20rpx;
  color: #EF4444;
}

/* ============== 列表 ============== */
.list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.day-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.day-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.day-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.day-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.day-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.day-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.day-age {
  font-size: 22rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: #F3F4F6;
}

.day-cat {
  font-size: 22rpx;
  font-weight: 500;
}

.day-countdown {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex-shrink: 0;
}

.countdown-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #EF4444;
  line-height: 1;
}

.countdown-unit {
  font-size: 22rpx;
  color: #EF4444;
}

.day-body {
  margin-top: 16rpx;
  padding: 0 4rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.day-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.row-label {
  font-size: 24rpx;
  color: #6B7280;
}

.day-foot {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #E5E7EB;
}

.foot-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* ============== 空 ============== */
.empty {
  padding: 120rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: #9CA3AF;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: #D1D5DB;
}
