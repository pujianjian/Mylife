.page {
  min-height: 100vh;
  background: #F3F4F6;
  padding: 24rpx 24rpx 200rpx;
}

.white-block {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 20rpx;
}

.block-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 16rpx;
}

.row-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1F2937;
}

.placeholder {
  color: #D1D5DB;
  font-size: 28rpx;
}

/* 名称 */
.name-input {
  font-size: 32rpx;
  color: #1F2937;
  padding: 8rpx 0;
}

/* 分类 */
.cat-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.cat-item {
  flex: 1 0 40%;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  background: #F9FAFB;
  border: 2rpx solid transparent;
}

.cat-icon {
  font-size: 36rpx;
}

.cat-name {
  font-size: 26rpx;
  color: #6B7280;
}

.cat-name.active {
  color: #1F2937;
  font-weight: 600;
}

/* 行 */
.row-block {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #6B7280;
}

.picker-arrow {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 2rpx;
}

/* 日期 */
.date-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.date-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.date-arrow {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 农历 */
.lunar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.lunar-label {
  width: 60rpx;
  font-size: 26rpx;
  color: #9CA3AF;
}

.lunar-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.lunar-tip {
  font-size: 22rpx;
  color: #9CA3AF;
}

.leap-toggle {
  margin-left: auto;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #F3F4F6;
  border: 2rpx solid #E5E7EB;
}

.leap-text {
  font-size: 24rpx;
  color: #6B7280;
}

.leap-text.active {
  color: #3B82F6;
  font-weight: 600;
}

/* 备注 */
.note-input {
  font-size: 28rpx;
  color: #1F2937;
  padding: 8rpx 0;
}

/* 提醒 */
.remind-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.remind-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.remind-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.remind-desc {
  font-size: 22rpx;
  color: #9CA3AF;
}

.remind-btn {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  background: #EFF6FF;
  color: #3B82F6;
  font-size: 26rpx;
  font-weight: 600;
}

/* 操作按钮 */
.action-wrap {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 48rpx;
  display: flex;
  gap: 16rpx;
}

.save-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  background: #93C5FD;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.save-btn.active {
  background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%);
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.3);
}

.delete-btn {
  width: 200rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #FEE2E2;
  color: #EF4444;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid #FECACA;
}
