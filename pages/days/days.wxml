<view class="page">
  <view class="header">
    <view class="title-wrap">
      <text class="title">重要的日子</text>
    </view>
    <view class="add-btn" bindtap="onAddTap">
      <text class="add-icon">+</text>
    </view>
  </view>

  <!-- 分类 Tab -->
  <scroll-view class="tabs" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      wx:for-item="t"
      class="{{t.tabClass}}"
      data-tab="{{t.key}}"
      bindtap="onTabSelect"
    >
      <text>{{t.name}}</text>
    </view>
  </scroll-view>

  <!-- 统计卡 -->
  <view class="stats">
    <view class="stat-card">
      <text class="stat-label">已记录</text>
      <view class="stat-value-wrap">
        <text class="stat-value">{{totalCount}}</text>
        <text class="stat-unit">位</text>
      </view>
    </view>
    <view class="stat-card highlight">
      <text class="stat-label">本月提醒</text>
      <view class="stat-value-wrap">
        <text class="stat-value">{{monthCount}}</text>
        <text class="stat-unit">位</text>
      </view>
    </view>
    <view class="stat-card">
      <text class="stat-label">最近一个</text>
      <view class="stat-nearest">
        <text class="stat-nearest-name">{{nearestName}}</text>
        <text wx:if="{{nearestDays != null}}" class="stat-nearest-meta">还有 {{nearestDays}} 天</text>
      </view>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <view
      wx:for="{{daysList}}"
      wx:key="id"
      wx:for-item="d"
      class="day-card"
      data-id="{{d.id}}"
      bindtap="onItemTap"
      style="{{d.cardStyle}}"
    >
      <view class="day-head">
        <view class="day-icon" style="{{d.iconStyle}}">
          <text class="day-icon-text">{{d.categoryIcon}}</text>
        </view>
        <view class="day-info">
          <view class="day-name-row">
            <text class="day-name">{{d.name}}</text>
            <text wx:if="{{d.ageLabel}}" class="day-age" style="{{d.catStyle}}">{{d.ageLabel}}</text>
          </view>
          <text class="day-cat" style="{{d.catStyle}}">{{d.categoryName}}</text>
        </view>
        <view wx:if="{{d.countdown != null}}" class="day-countdown">
          <text class="countdown-num">{{d.countdown}}</text>
          <text class="countdown-unit">天</text>
        </view>
      </view>

      <view class="day-body">
        <view class="day-row">
          <text class="row-label">{{d.calendarLabel}} {{d.date}}</text>
        </view>
        <view wx:if="{{d.nextDateStr}}" class="day-row">
          <text class="row-label">下次：{{d.nextLabel}}</text>
        </view>
        <view wx:if="{{d.elapsedLabel}}" class="day-row">
          <text class="row-label">已过 {{d.elapsedLabel}} 天</text>
        </view>
      </view>

      <view class="day-foot">
        <text class="foot-text">提前 {{d.remindDays || 3}} 天提醒</text>
      </view>
    </view>

    <view wx:if="{{daysList.length === 0}}" class="empty">
      <text class="empty-icon">📅</text>
      <text>暂无记录</text>
      <text class="empty-hint">点击右上角 + 开始记录</text>
    </view>
  </view>
</view>
